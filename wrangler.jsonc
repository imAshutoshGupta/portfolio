{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-terminal",
  // Wraps the worker OpenNext generates (.open-next/worker.js) to answer
  // byte-range requests for the demo videos: worker/ranges.ts.
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Static assets ignore Range (iOS Safari won't play a <video> without
    // 206), so the videos go to the worker first. Everything else is still
    // served straight from the assets.
    "run_worker_first": ["/projects/*.mp4"],
    // OpenNext's build requires these once run_worker_first is set (files only
    // at their exact path, as in Next). There are no .html assets, and a
    // missing file already fell through to the app, so nothing else changes.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Footer counters (page views, Semi pokes): app/api/_lib/counter.ts
  "kv_namespaces": [{ "binding": "COUNTERS", "id": "adc6d0c1554943d3824766538e38918b" }],
  // Caps counter writes per IP, per counter: 20 a minute is far above a real
  // visitor (one view per session, pokes sent in batches) but stops a script
  // from burning through KV's write limits. namespace_id is any number unique
  // to this account.
  "ratelimits": [{ "name": "COUNTER_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": {
    "enabled": true
  },
  // Preview builds (non-main branches) don't inherit bindings from above, so
  // without these the footer counters hide themselves on every preview. They
  // share the live counters, so test pokes and views add to the real totals.
  "previews": {
    "kv_namespaces": [{ "binding": "COUNTERS", "id": "adc6d0c1554943d3824766538e38918b" }],
    "ratelimits": [{ "name": "COUNTER_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
  }
}
