# --- Spotify "Now Playing" (optional) ---
# Without these (and without the Last.fm vars below), "Now playing" shows the
# idle line from content.ts ("Silence, for now;").
# Spotify's Web API needs Premium on the app owner's account; the live site
# uses Last.fm instead.
# Create an app at https://developer.spotify.com/dashboard, then run the
# auth-code flow once to get a long-lived refresh token with scope
# user-read-currently-playing user-read-recently-played.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Free alternative (no Spotify Premium needed): Last.fm scrobbling from Spotify.
# If both are set, they are used instead of the Spotify vars above.
# Get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=
