# Cloudflare Workers static assets: these rules apply only to files served
# from the assets (public/ and Next's build output), not to pages the worker
# renders; those get their headers from next.config.mjs.
# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

# Content-hashed build files never change under the same name, so browsers
# may keep them for a year. Nothing else gets long caching.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
